# Backend .dockerignore
# Files and directories to exclude from Docker build context

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.*
!.env.example

# Development files
.git/
.gitignore
*.md
!README.md

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
*.test.js
*.spec.js

# Logs
logs/
*.log

# Build artifacts
dist/
build/

# Temporary files
tmp/
temp/
*.tmp

# OS files
Thumbs.db
.DS_Store

# Documentation
docs/

# Scripts (except the ones we need)
scripts/check-*.js
scripts/test-*.js
