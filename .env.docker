# Docker Environment Configuration for JHUB Gallery
# Copy this file to .env in the root directory and update values as needed

# ============================================
# Application Environment
# ============================================
NODE_ENV=production
COMPOSE_PROJECT_NAME=jhub-gallery

# ============================================
# PostgreSQL Database Configuration
# ============================================
POSTGRES_DB=jhub_gallery
POSTGRES_USER=jhub_admin
POSTGRES_PASSWORD=jhub_password_change_me_in_production
POSTGRES_PORT=5432

# ============================================
# MinIO Object Storage Configuration
# ============================================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123_change_me_in_production
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_ORIGINAL=jhub-photos-original
MINIO_BUCKET_THUMBNAILS=jhub-photos-thumbnails

# ============================================
# Backend API Configuration
# ============================================
BACKEND_PORT=4000
API_PREFIX=/api

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# Upload Configuration
MAX_FILE_SIZE=52428800
MAX_FILES_PER_UPLOAD=500
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,image/bmp,image/tiff

# Thumbnail Configuration
THUMBNAIL_WIDTH=400
THUMBNAIL_HEIGHT=400
THUMBNAIL_QUALITY=80

# Share Link Configuration
SHARE_LINK_EXPIRY_DAYS=30

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_PORT=3000

# Backend API URL (for server-side and client-side)
# For local development: http://localhost:4000/api
# For production with domain: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# MinIO Endpoint (for client-side image access)
# For local development: http://localhost:9000
# For production with domain: https://minio.yourdomain.com
NEXT_PUBLIC_MINIO_ENDPOINT=http://localhost:9000

# App Configuration
NEXT_PUBLIC_APP_NAME=JHUB Gallery
NEXT_PUBLIC_MAX_FILE_SIZE=52428800
NEXT_PUBLIC_MAX_FILES_PER_UPLOAD=500

# CORS Origin (Frontend URL)
# For local development: http://localhost:3000
# For production: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# ============================================
# Production Deployment Notes
# ============================================
# When deploying to production:
# 1. Change all passwords and secrets
# 2. Update NEXT_PUBLIC_API_URL to your backend domain
# 3. Update NEXT_PUBLIC_MINIO_ENDPOINT to your MinIO domain
# 4. Update CORS_ORIGIN to your frontend domain
# 5. Consider using environment-specific .env files
# 6. Use strong, random passwords for database and MinIO
# 7. Enable SSL/TLS for all services
