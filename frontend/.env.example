# Frontend Environment Variables
# Copy this file to .env.local and update with your actual values

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# MinIO Configuration (for direct image access)
NEXT_PUBLIC_MINIO_ENDPOINT=http://localhost:9000
NEXT_PUBLIC_MINIO_BUCKET_ORIGINAL=jhub-photos-original
NEXT_PUBLIC_MINIO_BUCKET_THUMBNAILS=jhub-photos-thumbnails

# Legacy support
NEXT_PUBLIC_MINIO_URL=http://localhost:9000

# App Configuration
NEXT_PUBLIC_APP_NAME=JHUB Gallery
NEXT_PUBLIC_MAX_FILE_SIZE=52428800
NEXT_PUBLIC_MAX_FILES_PER_UPLOAD=500
